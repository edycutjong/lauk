{
  "name": "lauk",
  "private": true,
  "type": "module",
  "description": "Tap the plate you already bought. Lauk ranks one cheap add that makes it satisfying \u2014 never a calorie in sight.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "check": "tsx scripts/check.ts",
    "bench": "tsx scripts/bench.ts",
    "readiness": "tsx scripts/check-submission-readiness.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix app run typecheck",
    "bundle:check": "npm --prefix app run bundle:check",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run bench && npm run readiness",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.include='app/src/core/**' --coverage.include='app/src/rc/access.ts' --coverage.include='app/src/store/dates.ts'",
    "audit": "npm audit --audit-level=high && npm --prefix app audit --audit-level=high",
    "secrets": "gitleaks git --no-banner --redact .",
    "ci:full": "npm run ci && npm run bundle:check",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
