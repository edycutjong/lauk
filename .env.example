# Copy to app/.env (gitignored). PUBLIC SDK keys only — never a secret key.
# Every value here is sourced from ~/.config/lauk/secrets.env on the build machine.

# ── RevenueCat ───────────────────────────────────────────────
# Get from: https://app.revenuecat.com → Project "Lauk" → Apps → Test Store → Public API key
EXPO_PUBLIC_RC_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
# Get from: https://app.revenuecat.com → Project "Lauk" → Apps → Google Play (dev.edycu.lauk) → Public API key
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# Which key the build uses: TEST (dev build, instant no-charge purchases) or GOOGLE (release AAB).
# eas.json sets this per profile; for a local `expo run:android` leave TEST.
EXPO_PUBLIC_RC_STORE=TEST

# ── Release signing (prebuild-time, read by app/plugins/withReleaseSigning.js) ──
# Generate once: keytool -genkeypair -v -storetype PKCS12 -keystore ~/.config/lauk/upload-keystore.jks \
#   -alias lauk -keyalg RSA -keysize 4096 -validity 10000
# LAUK_KEYSTORE_PATH=/Users/you/.config/lauk/upload-keystore.jks
# LAUK_KEYSTORE_ALIAS=lauk
# LAUK_KEYSTORE_PASSWORD=change-me

# ── Submission readiness scan (optional) ─────────────────────
# Comma-separated creator names/handles that must never appear in judge-facing files (rules L244).
# LAUK_CREATOR_NAMES=
