# Copy to app/.env (gitignored). Public SDK keys only — never a secret key.
# Test Store key for development (dev build):
EXPO_PUBLIC_RC_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
# Google Play public key for the release build:
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# Which key the build uses: TEST (default in __DEV__) or GOOGLE.
EXPO_PUBLIC_RC_STORE=TEST
