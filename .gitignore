# Secrets never live in this tree — RevenueCat keys come from EXPO_PUBLIC_* env
# vars sourced from ~/.config/lauk/, the upload keystore from the same folder.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/
.DS_Store

# Expo / React Native — generated by `expo prebuild`, never committed.
app/.expo/
app/android/
app/ios/
*.tsbuildinfo
*.apk
*.aab

.eslintcache
.prettiercache
